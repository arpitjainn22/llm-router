# ============================================================
# LLM Router — Environment Configuration
# Copy this to .env and fill in your values
# ============================================================

# === Your LLM Provider Keys (for YOUR OWN testing only) ===
# Customers bring their own keys via the signup form
# You only need one key here for local development
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# === Database ===
# Local dev: use localhost
# Production (Docker): use postgres (the service name)
DATABASE_URL=postgresql+asyncpg://llmrouter:llmrouter@localhost:5432/llmrouter

# === Redis ===
REDIS_URL=redis://localhost:6379

# === App Settings ===
# Generate a strong random secret: openssl rand -hex 32
APP_SECRET_KEY=change-this-to-a-long-random-string
ENVIRONMENT=development
LOG_LEVEL=INFO

# === Routing Config ===
SHADOW_ROUTING_FRACTION=0.0
DEFAULT_COST_BUDGET_USD=0.01

# === Email (Resend — https://resend.com) ===
# Free tier: 3,000 emails/month
# Sign up, verify domain, get API key
RESEND_API_KEY=

# === Pricing (USD per 1K tokens) ===
HAIKU_INPUT_PRICE=0.00025
HAIKU_OUTPUT_PRICE=0.00125
SONNET_INPUT_PRICE=0.003
SONNET_OUTPUT_PRICE=0.015
GPT4O_MINI_INPUT_PRICE=0.00015
GPT4O_MINI_OUTPUT_PRICE=0.0006
GPT4O_INPUT_PRICE=0.005
GPT4O_OUTPUT_PRICE=0.015
GEMINI_FLASH_INPUT_PRICE=0.000075
GEMINI_FLASH_OUTPUT_PRICE=0.0003

# === Email — Gmail SMTP (free, no domain needed) ===
# Step 1: Enable 2FA at myaccount.google.com/security
# Step 2: Create app password at myaccount.google.com/apppasswords
# Step 3: Add credentials below
GMAIL_USER=your-gmail@gmail.com
GMAIL_APP_PASSWORD=your-16-char-app-password
